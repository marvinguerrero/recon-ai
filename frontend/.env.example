# ─── Supabase (public/anon — safe to expose to the browser) ──────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── API origin ───────────────────────────────────────────────────────────────
# Leave blank for local dev (Vite proxies /api → localhost:5000).
# Set to your deployed backend URL for production (e.g. Render).
VITE_API_BASE_URL=https://your-backend.onrender.com
