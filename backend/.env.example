# ─── Supabase ─────────────────────────────────────────────────────────────────
# Service-role key — NEVER expose to the frontend or commit to git.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PostgreSQL connection string (Supabase Dashboard → Settings → Database → URI)
# Use the pooler (port 6543) for serverless/short-lived processes (Render workers).
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# ─── Storage ──────────────────────────────────────────────────────────────────
# Name of the private Supabase Storage bucket for financial documents.
# Create it in the Supabase Dashboard → Storage before first upload.
SUPABASE_STORAGE_BUCKET=financial-documents

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
